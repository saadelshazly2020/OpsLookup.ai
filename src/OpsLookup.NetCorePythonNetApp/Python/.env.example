# Copy to .env and fill in. This app is fully independent of OpsLookup.Graph:
# its own virtualenv, its own checkpoint database, its own tokens.

# --- .NET data API (OpsLookup.Api) --------------------------------------------
# launchSettings.json binds http://localhost:5250 and https://localhost:7163.
# Prefer http: the ASP.NET Core development certificate is self-signed and
# httpx refuses it.
API_BASE_URL=http://localhost:5250

# Mint one with:
#   curl.exe -X POST "http://localhost:5250/auth/dev-token?operatorId=op-4471"
# Tokens expire after 60 minutes.
API_TOKEN=

OPERATOR_ID=op-4471

# --- Model --------------------------------------------------------------------
LONGCAT_API_KEY=
LONGCAT_BASE_URL=https://opencode.ai/zen/go/v1
LONGCAT_MODEL=longcat-2.5-preview-free

# Optional. Stable across restarts to keep the gateway's prompt cache warm.
# OPENCODE_SESSION_ID=

# --- LangGraph ----------------------------------------------------------------
# Relative paths resolve against this app's Python folder, not the process
# working directory, so two apps cannot collide on one checkpoint file.
CHECKPOINT_PATH=checkpoints.sqlite
RECURSION_LIMIT=10
REQUEST_TIMEOUT_SECONDS=20
LOG_LEVEL=INFO
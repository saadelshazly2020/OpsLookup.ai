# Copy to .env and fill in.

# --- .NET API -----------------------------------------------------------------
# launchSettings.json binds http://localhost:5250 and https://localhost:7163.
# Prefer the http URL locally: the ASP.NET Core development certificate is
# self-signed, so httpx will refuse https with CERTIFICATE_VERIFY_FAILED.
API_BASE_URL=http://localhost:5250

# Bearer token for the .NET API. Mint one locally with:
#   curl.exe -X POST "http://localhost:5250/auth/dev-token?operatorId=op-4471"
# Tokens last 60 minutes. Leave this blank here and fill in your own copy —
# never paste a real token or key into this file, it is committed to git.
API_TOKEN=

OPERATOR_ID=op-4471

# --- LongCat ------------------------------------------------------------------
# Leave blank here. Put your real key in your own untracked .env copy.
LONGCAT_API_KEY=
LONGCAT_BASE_URL=https://opencode.ai/zen/go/v1
LONGCAT_MODEL=longcat-2.5-preview-free

# --- LangGraph ----------------------------------------------------------------
CHECKPOINT_PATH=checkpoints.sqlite
RECURSION_LIMIT=10
REQUEST_TIMEOUT_SECONDS=20
LOG_LEVEL=INFO

# --- Optional: trusting the ASP.NET Core dev certificate ----------------------
# Only needed if you insist on the https URL. Export the dev cert to PEM first:
#   dotnet dev-certs https --export-path devcert.pem --format PEM
# then set SSL_CERT_FILE to its absolute path and add the root cert if prompted.
# SSL_CERT_FILE=